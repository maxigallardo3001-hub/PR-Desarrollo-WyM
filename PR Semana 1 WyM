<!DOCTYPE html>
<html lang="en">
<head>
  <title>Bootstrap 5 Example</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>

<div class="container-fluid mt-4">

  <div class="row">
  	<div class="bg-light-subtle col-12">
    <p class="text-center">Logo</p></div>
  </div>
  
  <div class="row">
  	<div class="bg-dark-subtle col-12">NavBar</div>
  </div>
  
  <div class="row">
  	<div class="bg-primary col-10 mx-auto p-2">
    <p class="text-center">Titulo</p></div>
  </div>
  
  <div class="row">
  	<div class="bg-secondary col-10 mx-auto p-2">
    <p class="text-center">Imagen</p></div>
  </div>
  
  <div class="row">
  	<div class="bg-danger col-4">Izq</div>
    <div class="bg-info col-4">Centro</div>
    <div class="bg-danger col-4">Derecha</div>
  </div>
  
   <div class="row">
  	<div class="bg-primary col-10 mx-auto p-2">
    <p class="text-center">Anuncio</p></div>
  </div>
  
   <div class="row">
  	<div class="bg-warning col-12">Pie de pag</div>
  </div>
</div> 

</body>
</html>

